# Copy to .env and fill in. NEVER commit .env.
# ---- secrets you provide ----
GROQ_API_KEY=
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
PG_PASSWORD=change-me-strong

# ---- local defaults (usually leave as-is) ----
POSTGRES_USER=agent
POSTGRES_DB=agent

# Auth between orchestrator and the LiteLLM proxy (local only).
LITELLM_MASTER_KEY=sk-local-master-change-me

# Native Ollama on the Mac host, reached from inside containers.
# (Docker Desktop maps host.docker.internal to the host automatically.)
OLLAMA_API_BASE=http://host.docker.internal:11434
