              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/espacios/{espacio_id}/mensajes": {
      "post": {
        "tags": [
          "espacios"
        ],
        "summary": "Encolar Mensaje",
        "description": "Encola el mensaje en la cola durable del espacio. Si no hay sesión viva, la\ncrea vía session.py (carril local del config). En TESTS la fábrica de\nsesiones está stubbeada: NO corre inferencia (el test no espera 80s de\nqwen). El loop real de tool-use corre en el worker thread del SessionManager.",
        "operationId": "encolar_mensaje_espacios__espacio_id__mensajes_post",
        "parameters": [
          {
            "name": "espacio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Espacio Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MensajeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeEncoladoResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/espacios/{espacio_id}/stream": {
      "get": {
        "tags": [
          "espacios"
        ],
        "summary": "Stream Espacio",
        "description": "SSE esqueleto real: sirve los eventos del events.jsonl del espacio como\ntext/event-stream, con id incremental por evento + heartbeat. Soporta\nLast-Event-ID (header estándar o ?lastEventId=) para replay: arranca en el\nsiguiente evento. NO replay fingido — cada evento nace del events.jsonl real\n(que la Sesión persiste antes de emitir).",
        "operationId": "stream_espacio_espacios__espacio_id__stream_get",
        "parameters": [
          {
            "name": "espacio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Espacio Id"
            }
          },
          {
            "name": "lastEventId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lasteventid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/espacios/{espacio_id}/aprobaciones/{gate_id}": {
      "post": {
        "tags": [
          "espacios"
        ],
        "summary": "Resolver Aprobacion",
        "description": "Conecta el OK/NO del usuario al .approve()/.reject() de la Sesión viva (el\ncontrato de 0014). Si no hay sesión viva, o no hay gate pendiente, lo dice\nhonestamente (no inventa una aprobación). El gate_id se registra para\ntrazabilidad y se persiste como evento del hilo.",
        "operationId": "resolver_aprobacion_espacios__espacio_id__aprobaciones__gate_id__post",
        "parameters": [
          {
            "name": "espacio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Espacio Id"
            }
          },
          {
            "name": "gate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Gate Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AprobacionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AprobacionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
