{
  "openapi": "3.1.0",
  "info": {
    "title": "puppet-ai-core",
    "description": "Backend API for Puppet AI — agent creation platform",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/catalog/brands": {
      "get": {
        "summary": "Get Brands",
        "description": "Declared brands per belt server + per-template gate copy.\nThe UI consumes this verbatim (label, monogram, color, logo, human connection\nname) and NEVER guesses. Registered before /catalog/{nicho} so 'brands' is\nnot matched as a nicho. PARAMETRIZABLE — see catalog/brands.json.",
        "operationId": "get_brands_catalog_brands_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/catalog/{nicho}": {
      "get": {
        "summary": "Get Catalog",
        "description": "List templates for a given nicho.\nnicho is a path parameter — fully parametrizable, zero hardcoded domain names.\nTemplates are filtered by tier based on the requesting user's tier.\nUnknown/absent user_id → free tier (most restrictive; for finanzas = 7 templates).",
        "operationId": "get_catalog_catalog__nicho__get",
        "parameters": [
          {
            "name": "nicho",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Nicho"
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "User ID for tier-based gating",
              "title": "User Id"
            },
            "description": "User ID for tier-based gating"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/configs/validate": {
      "post": {
        "summary": "Validate Config Endpoint",
        "description": "Validate a config.json against the assembler contract:\n- Required fields present\n- belt_path resolves to an existing file\n- framing_path resolves (if provided)\n- tool_filters keys must be real servers in the belt (phantom server keys FAIL)\n- tool_filters values (tool names) are validated against the sondado surface for\n  cero-friccion servers (excel/25 tools, secedgar/21 tools, jupyter/18 tools);\n  solo-spec servers (sheets, stata, alphavantage, fred) accept any tool name with\n  a 'no-sondado' warning — their surface was not verified via tools/list execution.",
        "operationId": "validate_config_endpoint_configs_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigValidateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/agents": {
      "post": {
        "summary": "Create Agent",
        "description": "Create an agent:\n1. Validate config against assembler contract\n2. Persist agent record to agents store\n3. Register in flywheel via platform/flywheel/capture.py\nReturns the created agent record.",
        "operationId": "create_agent_agents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentCreatedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/agents/{agent_id}/try": {
      "post": {
        "summary": "Try Agent",
        "description": "Run the REAL agent one-shot against a single user message and return the raw\ntranscript (final answer + summarized tool calls). Uses the assembler via the\nadditive run_once wrapper; the model lane is resolved server-side (see\ntry_runner). Generous timeout (180s). The agent's API key is never returned.\n\nPROHIBIDO: respuestas enlatadas. This executes the agent for real or returns\nan honest error.",
        "operationId": "try_agent_agents__agent_id__try_post",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Agent Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentTryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentTryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/espacios": {
      "post": {
        "tags": [
          "espacios"
        ],
        "summary": "Crear Espacio",
        "description": "Crea un espacio. Si viene `arrancador_id`, copia la config del template del\ncatálogo (el catálogo como data source); `config` explícita la sobreescribe\n(espacio armado de cero). Sin ninguno, arranca con config mínima vacía.",
        "operationId": "crear_espacio_espacios_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EspacioCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EspacioResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/espacios/{espacio_id}": {
      "get": {
        "tags": [
          "espacios"
        ],
        "summary": "Obtener Espacio",
        "operationId": "obtener_espacio_espacios__espacio_id__get",
        "parameters": [
          {
            "name": "espacio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Espacio Id"
