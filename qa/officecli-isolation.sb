(version 1)
(allow default)
(deny network*)
(deny file-write*)
(deny file-read* (subpath "/Users") (subpath "/Applications"))
(allow file-read-metadata (subpath "/Users"))
(deny signal)
(allow signal (target self))
(allow file-read* (subpath (param "TEST_ROOT")) (literal (param "BINARY")))
(allow file-write* (subpath (param "TEST_ROOT")) (literal "/dev/null"))
